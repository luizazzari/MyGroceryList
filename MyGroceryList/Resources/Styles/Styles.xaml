<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F7F3, Dark=#111B17}" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light=#F5F7F3, Dark=#111B17}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light=#173C2D, Dark=#E3F1E8}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light=#166548, Dark=#90DCB6}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#203C30, Dark=#E3F1E8}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
    </Style>
    <Style TargetType="Label" x:Key="PageHeading">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#173C2D, Dark=#E3F1E8}" />
    </Style>
    <Style TargetType="Label" x:Key="MutedText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#52695C, Dark=#B2C7B9}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style TargetType="Label" x:Key="Eyebrow">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#166548, Dark=#90DCB6}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>
    <Style TargetType="Label" x:Key="ErrorText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#A92D35, Dark=#FFB2B8}" />
        <Setter Property="FontSize" Value="15" />
        <Style.Triggers><Trigger TargetType="Label" Property="Text" Value=""><Setter Property="IsVisible" Value="False" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#166548, Dark=#90DCB6}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#103B29}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style TargetType="Button" x:Key="TextButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#166548, Dark=#90DCB6}" />
        <Setter Property="Padding" Value="8,10" />
    </Style>
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1D2C24}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#D9E4DB, Dark=#354C3E}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#203C30, Dark=#E3F1E8}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#637A6C, Dark=#AAC0B1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#203C30, Dark=#E3F1E8}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#637A6C, Dark=#AAC0B1}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#203C30, Dark=#E3F1E8}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light=#52695C, Dark=#B2C7B9}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light=#166548, Dark=#90DCB6}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBE9DD, Dark=#354C3E}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light=#166548, Dark=#90DCB6}" />
    </Style>
</ResourceDictionary>
