<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>
    <Style TargetType="Label" x:Key="BodyText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource BodyText}" />
    <Style TargetType="Label" x:Key="PageHeading" BasedOn="{StaticResource BodyText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    <Style TargetType="Label" x:Key="MutedText" BasedOn="{StaticResource BodyText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Label" x:Key="FieldLabel" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>
    <Style TargetType="Label" x:Key="ErrorText" BasedOn="{StaticResource BodyText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="FontSize" Value="14" />
        <Style.Triggers>
            <Trigger TargetType="Label" Property="Text" Value=""><Setter Property="IsVisible" Value="False" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#0D2C16}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />
    <Style TargetType="Button" x:Key="TextButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="8,10" />
    </Style>
    <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource TextButton}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumWidthRequest" Value="48" />
    </Style>
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style TargetType="Border" x:Key="Field" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
    </Style>
</ResourceDictionary>
