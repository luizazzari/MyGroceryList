<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyGroceryList.Mobile.ViewModels"
             x:Class="MyGroceryList.Mobile.Views.ItemEditorPage"
             x:DataType="vm:ItemEditorViewModel" Title="Editar produto">
    <Grid RowDefinitions="*,Auto" Padding="20,12,20,16" RowSpacing="12">
        <ScrollView>
            <VerticalStackLayout Spacing="10">
                <Label Text="DO SEU JEITO" Style="{StaticResource Eyebrow}" />
                <Label Text="Ajustar produto" Style="{StaticResource PageHeading}" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Produto" /><Entry Text="{Binding Name}" MaxLength="160" SemanticProperties.Description="Nome do produto" />
                <Label Text="Quantidade (opcional)" /><Entry Text="{Binding Quantity}" Keyboard="Numeric" Placeholder="Ex.: 1,5" SemanticProperties.Description="Quantidade opcional; use vírgula para decimais" />
                <Label Text="Unidade (opcional)" /><Entry Text="{Binding Unit}" Placeholder="kg, g, L, un…" MaxLength="24" SemanticProperties.Description="Unidade de medida opcional" />
                <Label Text="Setor" /><Picker ItemsSource="{Binding AvailableSectors}" SelectedItem="{Binding Sector}" Title="Escolha o setor" SemanticProperties.Description="Setor do supermercado" />
                <Label Text="Este setor será lembrado nas próximas inclusões do produto." Style="{StaticResource MutedText}" FontSize="13" />
                <Label Text="Observação (opcional)" /><Editor Text="{Binding Note}" AutoSize="TextChanges" MinimumHeightRequest="90" MaxLength="500" Placeholder="Marca, maturação, substituição…" SemanticProperties.Description="Observação opcional do produto" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Text="Tentar carregar novamente" Command="{Binding LoadCommand}" Style="{StaticResource TextButton}">
                    <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsLoaded}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></Button.Triggers>
                </Button>
                <Button Text="Excluir produto" Command="{Binding DeleteCommand}" Style="{StaticResource TextButton}" TextColor="{AppThemeBinding Light=#A92D35, Dark=#FFB2B8}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Text="Salvar alterações" Command="{Binding SaveCommand}" IsEnabled="{Binding IsLoaded}" />
    </Grid>
</ContentPage>
