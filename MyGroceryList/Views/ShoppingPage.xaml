<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyGroceryList.Mobile.ViewModels"
             xmlns:controls="clr-namespace:MyGroceryList.Mobile.Controls"
             x:Class="MyGroceryList.Mobile.Views.ShoppingPage"
             x:DataType="vm:ShoppingViewModel" Title="{Binding Title}">
    <Shell.TitleView><controls:BrandTitle /></Shell.TitleView>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mais opções" Clicked="ShowOptions" Order="Primary">
            <ToolbarItem.IconImageSource><FontImageSource Glyph="⋮" Size="26" Color="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" /></ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid Padding="20,16,20,14" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <VerticalStackLayout Spacing="9">
            <Label Text="{Binding Title}" Style="{StaticResource PageHeading}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}" FontSize="16" />
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="0" Margin="0,4,0,8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}">
                <ProgressBar Progress="{Binding Progress}" HeightRequest="8" SemanticProperties.Description="{Binding ProgressLabel}" />
            </Border>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            <Button Text="Tentar novamente" Command="{Binding LoadCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ErrorMessage}" Value=""><Setter Property="IsVisible" Value="False" /></DataTrigger></Button.Triggers>
            </Button>
        </VerticalStackLayout>
        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None" ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.Header>
                    <Border x:DataType="vm:ShoppingViewModel" IsVisible="{Binding AllPurchased}" Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 14" Margin="0,10,0,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SoftGreenLight}, Dark={StaticResource SoftGreenDark}}">
                        <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding ShowPurchased}" Value="True"><Setter Property="IsVisible" Value="False" /></DataTrigger></Border.Triggers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tudo no carrinho! ✓" FontSize="20" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                            <Label Text="Sua lista está em dia." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.Header>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:ItemGroup">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="12,9" Margin="0,10,0,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftGreenLight}, Dark={StaticResource SoftGreenDark}}">
                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" SemanticProperties.HeadingLevel="Level2" />
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemRowViewModel">
                        <Border Style="{StaticResource Card}" Padding="8,3,0,3" Margin="0,0,0,7">
                            <Grid ColumnDefinitions="*,48">
                                <Grid Padding="4,11,0,11" ColumnDefinitions="28,34,*,Auto" ColumnSpacing="10" MinimumHeightRequest="62"
                                      AutomationProperties.IsInAccessibleTree="True" SemanticProperties.Description="{Binding AccessibilityLabel}"
                                      SemanticProperties.Hint="Toque duas vezes para marcar ou desmarcar">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleCommand}" /></Grid.GestureRecognizers>
                                    <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 6" StrokeThickness="1.8"
                                            Stroke="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                                            BackgroundColor="Transparent" VerticalOptions="Center" InputTransparent="True">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPurchased}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="✓" IsVisible="{Binding IsPurchased}" FontSize="20" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light=White, Dark=#102B15}" HorizontalOptions="Center" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding ProductIcon}" FontFamily="{x:Null}" FontSize="28" FontAutoScalingEnabled="False"
                                           VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center" InputTransparent="True">
                                        <Label Text="{Binding Name}" FontSize="17">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" Style="{StaticResource MutedText}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding QuantityLabel}" FontSize="15" VerticalOptions="Center" InputTransparent="True" MaximumWidthRequest="96">
                                        <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsPurchased}" Value="True"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" /></DataTrigger></Label.Triggers>
                                    </Label>
                                </Grid>
                                <Button Grid.Column="1" Text="⋯" Style="{StaticResource IconButton}" Command="{Binding EditCommand}"
                                        VerticalOptions="Center" SemanticProperties.Description="{Binding EditAccessibilityLabel}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout x:DataType="vm:ShoppingViewModel" Padding="0,8,0,12">
                        <Button Text="{Binding PurchasedLabel}" Command="{Binding TogglePurchasedCommand}" IsVisible="{Binding HasPurchased}" Style="{StaticResource TextButton}" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
            <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="24" Spacing="10" VerticalOptions="Center" InputTransparent="True">
                <Label Text="Sua lista está vazia" FontSize="22" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                <Label Text="Toque em Adicionar item para começar." Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="End" VerticalOptions="Start" InputTransparent="True" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanUndo}">
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Desfazer" Command="{Binding UndoCommand}" Style="{StaticResource TextButton}" />
        </Grid>
        <VerticalStackLayout Grid.Row="4" Spacing="4">
            <Button x:Name="OpenQuickEntryButton" Text="＋  Adicionar item" Clicked="FocusQuickEntry" />
            <VerticalStackLayout x:Name="QuickEntryPanel" IsVisible="False" Spacing="0">
                <Border Style="{StaticResource Field}" Padding="12,4">
                    <Grid ColumnDefinitions="*,48" ColumnSpacing="6">
                        <Entry x:Name="QuickEntryField" Text="{Binding QuickEntry}" Placeholder="Ex.: 1,5 kg de arroz" ReturnType="Next"
                               ReturnCommand="{Binding AddCommand}" SemanticProperties.Description="Nome do produto e quantidade opcional" />
                        <Button Grid.Column="1" Text="＋" Command="{Binding AddCommand}" Padding="0" FontSize="24" MinimumHeightRequest="48" SemanticProperties.Description="Adicionar item" />
                    </Grid>
                </Border>
                <Button Text="Fechar" Clicked="CloseQuickEntry" Style="{StaticResource TextButton}" HorizontalOptions="End" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
