<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyGroceryList.Mobile.ViewModels"
             xmlns:controls="clr-namespace:MyGroceryList.Mobile.Controls"
             x:Class="MyGroceryList.Mobile.Views.ListsPage"
             x:DataType="vm:ListsViewModel" Title="MyGroceryList">
    <Shell.TitleView><controls:BrandTitle /></Shell.TitleView>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mais opções" Clicked="ShowOptions" Order="Primary">
            <ToolbarItem.IconImageSource><FontImageSource Glyph="⋮" Size="26" Color="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" /></ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid Padding="20,16,20,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding SectionTitle}" Style="{StaticResource PageHeading}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Uma lista para cada compra." Style="{StaticResource MutedText}">
                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding ShowingArchived}" Value="True"><Setter Property="Text" Value="Suas listas guardadas, sempre à mão." /></DataTrigger></Label.Triggers>
            </Label>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="0">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            <Button Text="Tentar novamente" Command="{Binding LoadCommand}" Style="{StaticResource TextButton}" HorizontalOptions="Start">
                <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ErrorMessage}" Value=""><Setter Property="IsVisible" Value="False" /></DataTrigger></Button.Triggers>
            </Button>
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Lists}" SelectionMode="None" ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20,50" Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="76" HeightRequest="76" StrokeThickness="0" StrokeShape="RoundRectangle 25"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SoftGreenLight}, Dark={StaticResource SoftGreenDark}}" HorizontalOptions="Center">
                        <Label Text="☷" FontSize="38" FontFamily="OpenSansRegular" HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Label Text="{Binding EmptyTitle}" FontSize="22" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptyDescription}" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ListCard">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,16">
                        <Grid ColumnDefinitions="42,*,48" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListsViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="42" VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftGreenLight}, Dark={StaticResource SoftGreenDark}}">
                                <Label Text="☷" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" AutomationProperties.IsInAccessibleTree="False" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}" FontSize="13" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="›" Style="{StaticResource IconButton}" VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListsViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibilityLabel}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3" Text="＋  Nova lista" Command="{Binding CreateCommand}" SemanticProperties.Description="Criar uma nova lista de compras" />
        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Start" HorizontalOptions="End" InputTransparent="True" />
    </Grid>
</ContentPage>
